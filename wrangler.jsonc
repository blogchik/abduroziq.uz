{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abduroziq-uz",
  "compatibility_date": "2026-11-12",
  // The site lives on its own domain only: no *.workers.dev copy, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/web/dist",
    // Serves dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // Default: files without slash, folder indexes with a trailing slash (matches Astro trailingSlash: 'always').
    "html_handling": "auto-trailing-slash",
  },
  // The production domain (the zone is active on Cloudflare). The deploy creates its DNS
  // record and certificate. www is not listed on purpose: a dashboard Redirect Rule sends it
  // to the apex (docs/DEPLOY.md).
  "routes": [{ "pattern": "abduroziq.uz", "custom_domain": true }],
}
