{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": [
    "PUBLIC_SITE_URL",
    "PUBLIC_ALLOW_INDEXING",
    "PUBLIC_ANALYTICS_TOKEN",
    "PUBLIC_GOOGLE_SITE_VERIFICATION",
    "PUBLIC_YANDEX_VERIFICATION",
    "PUBLIC_BING_SITE_VERIFICATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/content/**"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/packages/content/**"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/packages/content/**"
      ],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/content/**"],
      "outputs": []
    }
  }
}
