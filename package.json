{
  "name": "abduroziq.uz",
  "private": true,
  "version": "0.0.0",
  "description": "Personal website and blog of Abduroziq Jabborov",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @abduroziq/web preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm check:media && turbo run lint typecheck test build --concurrency=1",
    "check:media": "node apps/web/scripts/check-media.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@abduroziq/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "wrangler": "4.167.0"
  }
}
