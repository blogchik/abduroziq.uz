---
import type { GetStaticPaths } from 'astro';
import BlogHeader from '@/components/blog/BlogHeader.astro';
import ProjectRow from '@/components/projects/ProjectRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeParam, locales, resolveLocale, t } from '@/i18n';
import { getProjects } from '@/lib/projects';
import { breadcrumbSchema, projectsPageSchema } from '@/lib/seo/schema';

/**
 * The projects list (DESIGN 6.2): `/projects/` and `/uz/projects/`. The page title set like
 * the blog's, then one row per project in order: the name and the picture, with the facts
 * as mono lines. Every row is one link to the project's own page.
 */
export const getStaticPaths = (() =>
  locales.map((locale) => ({ params: { locale: localeParam(locale) } }))) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.params.locale);
const projects = await getProjects(locale);

// The first row is on the first screen with the title: its picture is the largest paint and
// loads first. The second can still show on a tall phone, so the reveal starts at the third.
const REVEAL_FROM = 2;
---

<BaseLayout
  locale={locale}
  path="/projects/"
  title={t(locale, 'seo.projects.title')}
  description={t(locale, 'seo.projects.description')}
  seo={{
    jsonLd: [
      projectsPageSchema(locale, projects),
      breadcrumbSchema(locale, [
        { name: t(locale, 'common.nav.home'), path: '/' },
        { name: t(locale, 'projects.title'), path: '/projects/' },
      ]),
    ],
  }}
>
  <BlogHeader title={t(locale, 'projects.title')} subtitle={t(locale, 'projects.intro')} />

  <ol class="projects shell">
    {projects.map((project, index) => (
      <ProjectRow
        project={project}
        index={index}
        locale={locale}
        priority={index === 0}
        reveal={index >= REVEAL_FROM}
      />
    ))}
  </ol>
</BaseLayout>

<style>
  .projects {
    margin-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0;
    padding-block-end: var(--section);
  }
</style>
