---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { mdxComponents } from '@/components/blog/mdx';
import ProjectCover from '@/components/projects/ProjectCover.astro';
import ProjectEnd from '@/components/projects/ProjectEnd.astro';
import ProjectFacts from '@/components/projects/ProjectFacts.astro';
import ProjectGallery from '@/components/projects/ProjectGallery.astro';
import ProjectHeader from '@/components/projects/ProjectHeader.astro';
import { ASIDE_AREA, PAGE_AREA } from '@/components/projects/media';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeParam, locales, resolveLocale, t } from '@/i18n';
import { getAdjacentProjects, getProject, getProjects } from '@/lib/projects';
import { breadcrumbSchema, projectSchema } from '@/lib/seo/schema';
import { absoluteUrl } from '@/lib/seo/site';
import '@/styles/prose.css';

/**
 * A project page (DESIGN 6.3): `/projects/<slug>/` and `/uz/projects/<slug>/`. Every project
 * has a page in every language (the yaml carries both); the long text is optional per
 * language. In order: name and summary; the cover at the full content width; the facts and
 * the stack in a column beside the text; the gallery; the next project and the way back.
 * A project without a cover shows its plate at the head of the facts column instead. Empty
 * parts are left out entirely.
 */
export const getStaticPaths = (async () =>
  (
    await Promise.all(
      locales.map(async (locale) =>
        (await getProjects(locale)).map((project) => ({
          params: { locale: localeParam(locale), slug: project.slug },
        })),
      ),
    )
  ).flat()) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.params.locale);
const project = await getProject(locale, Astro.params.slug);
if (!project) throw new Error(`Unknown project "${Astro.params.slug}".`);

const { prev, next } = await getAdjacentProjects(locale, project.slug);
const Body = project.body ? (await render(project.body)).Content : undefined;
// The position in the list is the number printed on a plate.
const index = (await getProjects(locale)).findIndex((other) => other.slug === project.slug);

// The cover joins the generated card in the structured data, as an absolute URL.
const coverImage = project.cover
  ? absoluteUrl((await getImage({ src: project.cover.src, width: 1200 })).src)
  : undefined;
---

<BaseLayout
  locale={locale}
  path={`/projects/${project.slug}/`}
  title={project.name}
  description={project.description}
  seo={{
    jsonLd: [
      projectSchema(project, { locale, coverImage }),
      breadcrumbSchema(locale, [
        { name: t(locale, 'common.nav.home'), path: '/' },
        { name: t(locale, 'projects.title'), path: '/projects/' },
        { name: project.name, path: project.href },
      ]),
    ],
  }}
>
  <article class="project">
    <ProjectHeader project={project} locale={locale} />

    {project.cover && (
      <div class="project__cover shell">
        <ProjectCover project={project} index={index} area={PAGE_AREA} priority />
      </div>
    )}

    <div class:list={['project__main shell', { 'project__main--plate': !project.cover }]}>
      <div class="project__aside">
        {!project.cover && (
          <ProjectCover project={project} index={index} area={ASIDE_AREA} class="project__plate" />
        )}
        <ProjectFacts project={project} locale={locale} />
      </div>

      {Body && (
        <div class="project__body prose type-article-body">
          <Body components={mdxComponents} />
        </div>
      )}
    </div>

    {project.gallery.length > 0 && <ProjectGallery project={project} locale={locale} />}

    <ProjectEnd locale={locale} prev={prev} next={next} />
  </article>
</BaseLayout>

<style>
  .project {
    --project-gap: clamp(3rem, 2.1rem + 4vw, 6rem);
  }

  .project__cover {
    margin-block-start: clamp(2.5rem, 2rem + 2.2vw, 4rem);
  }

  .project__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2.5rem, 2rem + 2.2vw, 4rem);
    margin-block: var(--project-gap);
  }

  .project__aside {
    display: grid;
    gap: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    align-content: start;
    min-width: 0;
  }

  /* The text keeps the reading measure of the blog and starts at the column's left edge. */
  .project__body {
    margin-inline: 0;
  }

  /* Its first heading starts level with the facts beside it. */
  .project__body > :global(:first-child) {
    margin-block-start: 0;
  }

  /* Desktop: the facts in the first four columns, the text from the sixth. */
  @media (width >= 64rem) {
    .project__main {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .project__aside {
      grid-column: 1 / span 4;
    }

    .project__body {
      grid-column: 6 / -1;
    }
  }

  /* Only where the whole column fits under the header: a sticky box taller than the screen
     would hide its own end. */
  @media (width >= 64rem) and (height >= 48rem) {
    .project__aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
