---
import type { GetStaticPaths } from 'astro';
import About from '@/components/home/About.astro';
import Building from '@/components/home/Building.astro';
import Hero from '@/components/home/Hero.astro';
import Writing from '@/components/home/Writing.astro';
import Tape from '@/components/ui/Tape.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeParam, locales, resolveLocale, t } from '@/i18n';
import { getPosts } from '@/lib/posts';
import { personSchema, profilePageSchema, websiteSchema } from '@/lib/seo/schema';

/**
 * The home page (DESIGN section 4): `00 — Hello` with the desk, `01 — About`, the tape,
 * `02 — Building`, `03 — Writing`. `04 — Contact` is the footer in BaseLayout.
 * Headings: the hero sentence is the `h1`; each numbered section label is an `h2`;
 * post titles are `h3`. Projects are a table (row headers), not headings.
 */
export const getStaticPaths = (() =>
  locales.map((locale) => ({ params: { locale: localeParam(locale) } }))) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.params.locale);
const latest = (await getPosts(locale, { includeOtherLocale: true })).slice(0, 3);
---

<BaseLayout
  locale={locale}
  path="/"
  title={t(locale, 'seo.home.title')}
  description={t(locale, 'seo.home.description')}
  seo={{
    jsonLd: [websiteSchema(locale), personSchema(locale), profilePageSchema(locale)],
  }}
>
  <Hero locale={locale} />
  <About locale={locale} />
  <div class="home-tape">
    <Tape text={t(locale, 'home.tape')} />
  </div>
  <Building locale={locale} />
  <Writing locale={locale} posts={latest} />
</BaseLayout>

<style>
  /* The tape reserves the room its rotation needs; the section rhythm goes above it, and
     the Building section that it announces follows closely. */
  .home-tape {
    padding-block-start: calc(var(--section) * 0.6);
  }

  .home-tape + :global(.building) {
    padding-block-start: calc(var(--section) * 0.35);
  }
</style>
