---
import Desk from '@/components/home/desk/Desk.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Container from '@/components/ui/Container.astro';
import GiantName from '@/components/ui/GiantName.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, t } from '@/i18n';

/**
 * 404 (DESIGN section 6): an ink band with a giant `404` (the page's `h1`), one line, a
 * link home and three desk objects to throw. On wide screens the desk is the whole band,
 * so the objects can be thrown across the digits; on small ones it is a band of its own.
 */
const locale = 'en';
---

<BaseLayout
  locale={locale}
  path="/404/"
  title={t(locale, 'seo.notFound.title')}
  description={t(locale, 'seo.notFound.description')}
  seo={{ noindex: true, alternateLocales: [locale] }}
>
  <section class="nf surface-ink">
    <Container class="nf__shell">
      <SectionLabel number="404" name={t(locale, 'common.notFound.title')} data-reveal="fade" />

      <div class="nf__grid">
        <div class="nf__digits">
          <GiantName as="h1" text="404" reveal="chars" revealDelay={0.1} />
        </div>
        <div class="nf__text">
          <p class="type-lead nf__line" data-reveal="lines" data-reveal-delay="0.5">
            {t(locale, 'home.notFound.line')}
          </p>
          <p class="nf__back" data-reveal="fade" data-reveal-delay="0.8">
            <ArrowLink
              href={localePath(locale, '/')}
              label={t(locale, 'home.notFound.home')}
              direction="left"
              arrowFirst
            />
          </p>
        </div>
      </div>

      <div class="nf__desk">
        <Desk locale={locale} variant="notfound" entrance={0.9} />
      </div>
      <Desk locale={locale} variant="notfound-band" entrance={0.3} class="nf__band" />
    </Container>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem) clamp(2rem, 1.4rem + 2.6vw, 3.75rem);
  }

  .nf :global(.nf__shell) {
    position: relative;
  }

  .nf__grid {
    display: grid;
    gap: clamp(1.5rem, 1.1rem + 1.8vw, 2.75rem) var(--col-gap);
    margin-block-start: clamp(1.5rem, 1.1rem + 1.8vw, 2.75rem);
  }

  .nf__line {
    max-width: 14em;
    margin: 0;
  }

  .nf__back {
    margin: clamp(1.25rem, 1rem + 1vw, 1.75rem) 0 0;
  }

  .nf__desk {
    display: none;
    position: absolute;
    inset: 0 var(--gutter);
    z-index: 2;
    pointer-events: none;
  }

  .nf__desk :global(.desk) {
    height: 100%;
  }

  .nf :global(.nf__band) {
    margin-block-start: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  @media (width >= 64rem) {
    /* The digits take the left of the band and never grow taller than the screen; the
       line and the link stand at their foot on the right. */
    .nf__grid {
      grid-template-columns: minmax(0, min(66%, 100svh)) minmax(0, 1fr);
      align-items: end;
    }

    .nf__text {
      padding-block-end: 0.4rem;
    }

    .nf__desk {
      display: block;
    }

    .nf :global(.nf__band) {
      display: none;
    }
  }
</style>
