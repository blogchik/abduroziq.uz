---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, t } from '@/i18n';

const locale = 'en';
---

<BaseLayout
  locale={locale}
  path="/404/"
  title={t(locale, 'seo.notFound.title')}
  description={t(locale, 'seo.notFound.description')}
  seo={{ noindex: true, alternateLocales: [locale] }}
>
  <h1>{t(locale, 'common.notFound.title')}</h1>
  <p>{t(locale, 'common.notFound.text')}</p>
  <p>
    <a href={localePath(locale, '/')}>{t(locale, 'common.notFound.home')}</a>
  </p>
</BaseLayout>
