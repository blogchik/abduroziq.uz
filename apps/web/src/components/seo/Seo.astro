---
import { PUBLIC_ALLOW_INDEXING, PUBLIC_SITE_URL } from 'astro:env/client';
import { profile } from '@abduroziq/content';
import { defaultLocale, localePath, locales, t, type Locale } from '@/i18n';
import type { SeoProps } from './types';

type Props = SeoProps;

const {
  locale,
  path,
  title,
  description,
  type = 'website',
  image,
  article,
  alternateLocales = [...locales],
  alternates,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = profile.name;
const absolute = (href: string) => new URL(href, PUBLIC_SITE_URL).href;

const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;
const canonical = absolute(localePath(locale, path));

const robots =
  PUBLIC_ALLOW_INDEXING === 'true' && !noindex
    ? 'index, follow, max-image-preview:large'
    : 'noindex, nofollow';

// hreflang only when the page exists in more than one locale.
const alternateLinks: { locale: Locale; href: string }[] = (
  alternates ?? alternateLocales.map((l) => ({ locale: l, href: localePath(l, path) }))
).map((alt) => ({ locale: alt.locale, href: absolute(alt.href) }));
const xDefault = alternateLinks.find((alt) => alt.locale === defaultLocale) ?? alternateLinks[0];

const ogImage = image ? absolute(image) : undefined;
const ldBlocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#ECEAE5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />

{alternateLinks.length > 1 && (
  <>
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
  </>
)}

<link
  rel="alternate"
  type="application/rss+xml"
  title={t(locale, 'seo.rss.title')}
  href={absolute(localePath(locale, '/rss.xml'))}
/>

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'uz' ? 'uz_UZ' : 'en_US'} />
{alternateLinks
  .filter((alt) => alt.locale !== locale)
  .map((alt) => (
    <meta property="og:locale:alternate" content={alt.locale === 'uz' ? 'uz_UZ' : 'en_US'} />
  ))}
{ogImage && <meta property="og:image" content={ogImage} />}

{type === 'article' && article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
    )}
    {article.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{ldBlocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block).replaceAll('<', '\\u003c')} />
))}
