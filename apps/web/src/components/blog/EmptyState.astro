---
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';

/**
 * The blog before its first post (DESIGN 4.6): one quiet row with the grammar of a post row,
 * a numeral standing in for the date, the line "The first post is being written." and the
 * RSS link. It must look finished, not broken.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="empty">
  <div class="empty__date" aria-hidden="true">
    <span class="type-label empty__badge">{t(locale, 'blog.emptyBadge')}</span>
    <span class="type-numeral empty__numeral">00</span>
  </div>
  <div class="empty__body">
    <p class="type-title empty__title">{t(locale, 'blog.empty')}</p>
    <p class="type-body empty__text">{t(locale, 'blog.emptyText')}</p>
    <p class="empty__link">
      <ArrowLink href={localePath(locale, '/rss.xml')} label={t(locale, 'blog.rss')} />
    </p>
  </div>
</div>

<style>
  .empty {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-block: clamp(1.75rem, 1.2rem + 1.6vw, 3rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-block: var(--hairline) solid var(--rule);
    border-block-start: 2px solid var(--ink);
  }

  @media (width >= 40rem) {
    .empty {
      grid-template-columns: 6rem minmax(0, 1fr);
    }
  }

  .empty__date {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--ink-soft);
  }

  .empty__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .empty__title {
    margin: calc(var(--fs-label) * 1.3 + 0.45rem) 0 0;
    max-width: 18em;
  }

  .empty__text {
    margin: 0;
    max-width: 36em;
    color: var(--ink-soft);
  }

  .empty__link {
    margin: 0.9rem 0 0;
  }
</style>
