---
import EmptyState from './EmptyState.astro';
import MonthTab from '@/components/ui/MonthTab.astro';
import PostRow from '@/components/ui/PostRow.astro';
import type { Locale } from '@/i18n';
import { groupPostsByMonth, type PostSummary } from '@/lib/posts';

/**
 * Posts grouped by month (DESIGN 5.2): an ink tab per month, then one `PostRow` per post
 * inside a list. Rows below the first two reveal in a staggered rise. With no posts it renders the empty state.
 */
interface Props {
  posts: PostSummary[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
const groups = groupPostsByMonth(posts);

// The first rows are on the first screen: they show at once. Later rows rise as they enter.
const REVEAL_FROM = 2;
let rowIndex = 0;
const revealFlags = groups.map((group) => group.posts.map(() => rowIndex++ >= REVEAL_FROM));
---

<div class="post-list shell">
  {groups.length === 0 ? (
    <EmptyState locale={locale} />
  ) : (
    groups.map((group, groupIndex) => (
      <section class="post-list__group">
        <MonthTab date={group.posts[0]!.date} locale={locale} />
        <ul
          class="post-list__rows"
          data-reveal-group={revealFlags[groupIndex]!.some(Boolean) ? '' : undefined}
        >
          {group.posts.map((post, postIndex) => (
            <li
              class="post-list__item"
              data-reveal-item={revealFlags[groupIndex]![postIndex] ? '' : undefined}
            >
              <PostRow post={post} locale={locale} as="div" />
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</div>

<style>
  .post-list {
    margin-block-start: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-block-end: var(--section);
  }

  .post-list__group + .post-list__group {
    margin-block-start: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .post-list__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* PostRow draws a hairline above itself and, as the last child, below itself. Each row sits
     in its own <li> here, so only the last row of a group keeps the closing hairline. */
  .post-list__item :global(.post-row) {
    border-block-end: 0;
  }

  .post-list__item:last-child :global(.post-row) {
    border-block-end: var(--hairline) solid var(--rule);
  }

  /* The month tab already sits on a 2px ink rule: the first row needs no hairline of its own. */
  .post-list__item:first-child :global(.post-row) {
    border-block-start: 0;
  }
</style>
