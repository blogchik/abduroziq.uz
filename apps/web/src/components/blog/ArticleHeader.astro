---
import { Image } from 'astro:assets';
import portrait from '@abduroziq/content/assets/portrait.jpg';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { formatDate, isoDate } from '@/lib/dates';
import { postTransitionName, type PostSummary } from '@/lib/posts';
import { authorName } from '@/lib/seo/site';
import { keepShortWordsTogether } from '@/lib/typography';

/**
 * Centred article header (DESIGN 5.3): a mono meta line (date, then reading time or, for a
 * note, the label `NOTE`, then language), a link to the other-language version when there is
 * one, the title in `article-title` (it carries the same `view-transition-name` as its row in
 * the lists, so it morphs), and the author row with the small round portrait.
 *
 * Nothing in the header is revealed by the motion kit: the title is the target of the
 * shared-element transition and must be in its final state in the first frame, and the rest is
 * above the fold, where a reveal would only delay the largest contentful paint.
 *
 * The meta line wraps between whole items only (each item keeps its trailing `/` and never
 * breaks inside), and the title keeps one-letter words with the next word.
 */
interface Props {
  post: PostSummary;
  locale: Locale;
  draft?: boolean;
  translation?: PostSummary | undefined;
}

const { post, locale, draft = false, translation } = Astro.props;
---

<header class="article-head shell">
  <p class="type-label article-head__meta">
    <span class="article-head__item">
      <time datetime={isoDate(post.date)}>{formatDate(post.date, locale)}</time>
    </span>
    <span class="article-head__item">
      {post.kind === 'note'
        ? t(locale, 'blog.note.label')
        : t(locale, 'blog.readingTime', { minutes: post.readingMinutes })}
    </span>
    <span class="article-head__item">{t(locale, `blog.language.${post.locale}`)}</span>
    {post.updated && (
      <span class="article-head__item">
        {t(locale, 'blog.updated', { date: formatDate(post.updated, locale) })}
      </span>
    )}
    {draft && <span class="article-head__item article-head__draft">{t(locale, 'blog.draft')}</span>}
  </p>

  {translation && (
    <p class="article-head__translation">
      <ArrowLink
        href={translation.url}
        hreflang={translation.locale}
        label={t(locale, `blog.post.alsoIn.${translation.locale}`)}
      />
    </p>
  )}

  <h1 class="type-article-title article-head__title" transition:name={postTransitionName(post)}>
    {keepShortWordsTogether(post.title)}
  </h1>

  <p class="article-head__author">
    <a class="article-head__author-link type-label" href={localePath(locale, '/')} rel="author">
      <Image
        class="article-head__portrait"
        src={portrait}
        alt=""
        width={56}
        height={56}
        loading="eager"
      />
      <span class="sr-only">{t(locale, 'blog.post.by')} </span>
      <span>{authorName}</span>
    </a>
  </p>
</header>

<style>
  .article-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-start: clamp(3rem, 1.6rem + 5.4vw, 7rem);
    padding-block-end: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem);
    text-align: center;
  }

  .article-head__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.8rem;
    margin: 0;
    color: var(--ink-soft);
  }

  /* An item never breaks inside; its `/` separator belongs to it and is decorative. */
  .article-head__item {
    white-space: nowrap;
  }

  .article-head__item:not(:last-child)::after {
    content: '/' / '';
    margin-inline-start: 0.8rem;
    color: var(--ink-soft);
  }

  .article-head__draft {
    color: var(--accent-text);
  }

  .article-head__translation {
    margin: 0.9rem 0 0;
  }

  .article-head__title {
    margin: clamp(1.25rem, 0.9rem + 1.4vw, 2.25rem) 0 0;
    max-width: min(100%, 15em);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .article-head__author {
    margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0;
  }

  .article-head__author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .article-head__author-link :global(.article-head__portrait) {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    background-color: var(--paper-raised);
  }
</style>
