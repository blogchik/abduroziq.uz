---
import CopyLink from './CopyLink.astro';
import Arrow from '@/components/ui/Arrow.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Tag from '@/components/ui/Tag.astro';
import { localePath, t, type Locale } from '@/i18n';
import { formatDate, isoDate } from '@/lib/dates';
import { postTransitionName, type PostSummary } from '@/lib/posts';
import { keepShortWordsTogether } from '@/lib/typography';

/**
 * End matter of an article (DESIGN 5.3): tags and `COPY LINK`, then `MORE ENTRIES` with the
 * previous and next post side by side inside a hairline frame, then a way back to the list.
 * The neighbours' titles carry the same `view-transition-name` as their own article titles.
 * With only one neighbour the empty slot holds a link to all posts; with none there is no
 * `MORE ENTRIES` frame at all, only the way back. The tags row is as wide as the body column.
 */
interface Props {
  locale: Locale;
  tags: string[];
  /** Absolute canonical URL, copied by the button. */
  url: string;
  prev?: PostSummary | undefined;
  next?: PostSummary | undefined;
}

const { locale, tags, url, prev, next } = Astro.props;
type Cell =
  | { kind: 'post'; post: PostSummary; side: 'prev' | 'next' }
  | { kind: 'all'; side: 'prev' | 'next' };

// The left slot is the older post, the right slot the newer one. A missing neighbour is
// replaced by a link back to the list, unless there is no neighbour at all.
const cells: Cell[] =
  prev || next
    ? [
        prev ? { kind: 'post', post: prev, side: 'prev' } : { kind: 'all', side: 'prev' },
        next ? { kind: 'post', post: next, side: 'next' } : { kind: 'all', side: 'next' },
      ]
    : [];
const listUrl = localePath(locale, '/blog/');
const showAllRow = !(prev || next) || Boolean(prev && next);
---

<footer class="end shell">
  <div class="end__bar">
    {tags.length > 0 && (
      <ul class="end__tags" aria-label={t(locale, 'blog.tags')}>
        {tags.map((tag) => (
          <li>
            <Tag label={tag} href={localePath(locale, `/blog/tag/${tag}/`)} />
          </li>
        ))}
      </ul>
    )}
    <CopyLink locale={locale} url={url} />
  </div>

  {cells.length > 0 && (
    <nav class="end__more" aria-labelledby="more-entries">
      <h2 class="type-label end__more-title" id="more-entries">
        {t(locale, 'blog.post.more')}
      </h2>
      <ul class="end__grid" data-reveal-group>
        {cells.map((cell) => (
          <li class="end__cell" data-rel={cell.side} data-reveal-item>
            {cell.kind === 'post' ? (
              <a class="end__link" href={cell.post.url} rel={cell.side} data-cursor="read">
                <span class="type-label end__dir">
                  {cell.side === 'prev' && <Arrow direction="left" />}
                  <span>
                    {t(
                      locale,
                      cell.side === 'prev' ? 'blog.post.previousShort' : 'blog.post.nextShort',
                    )}
                  </span>
                  {cell.side === 'next' && <Arrow direction="right" />}
                </span>
                <span class="type-title end__title" transition:name={postTransitionName(cell.post)}>
                  {keepShortWordsTogether(cell.post.title)}
                </span>
                <time class="type-label end__date" datetime={isoDate(cell.post.date)}>
                  {formatDate(cell.post.date, locale)}
                </time>
              </a>
            ) : (
              <a class="end__link" href={listUrl} data-cursor="read">
                <span class="type-label end__dir">
                  {cell.side === 'prev' && <Arrow direction="left" />}
                  <span>{t(locale, 'blog.title')}</span>
                  {cell.side === 'next' && <Arrow direction="right" />}
                </span>
                <span class="type-title end__title">{t(locale, 'blog.tag.all')}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )}

  {showAllRow && (
    <p class="end__all">
      <ArrowLink
        href={localePath(locale, '/blog/')}
        label={t(locale, 'blog.tag.all')}
        direction="left"
        arrowFirst
      />
    </p>
  )}
</footer>

<style>
  .end {
    --end-column: 680px;
    display: flex;
    flex-direction: column;
    max-width: min(920px, 100%);
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--section);
  }

  /* The tags row lines up with the 680px body column above it. */
  .end__bar {
    width: 100%;
    max-width: var(--end-column);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem var(--col-gap);
    padding-block-start: 1.5rem;
    border-block-start: var(--hairline) solid var(--rule);
  }

  .end__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .end__more {
    margin-block-start: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .end__more-title {
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
  }

  .end__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--hairline) solid var(--ink);
  }

  .end__cell + .end__cell {
    border-block-start: var(--hairline) solid var(--ink);
  }

  @media (width >= 48rem) {
    .end__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .end__cell + .end__cell {
      border-block-start: 0;
      border-inline-start: var(--hairline) solid var(--ink);
    }
  }

  .end__link {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 2rem);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .end__cell[data-rel='next'] .end__link {
    text-align: end;
    align-items: flex-end;
  }

  .end__link:is(:hover, :focus-visible) {
    background-color: var(--paper-raised);
  }

  .end__link:focus-visible {
    outline-offset: -3px;
  }

  .end__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--ink-soft);
  }

  .end__dir :global(.arrow) {
    color: var(--accent-text);
    transition: translate var(--dur-2) var(--ease-out);
  }

  .end__cell[data-rel='prev'] .end__link:is(:hover, :focus-visible) .end__dir :global(.arrow) {
    translate: -4px 0;
  }

  .end__cell[data-rel='next'] .end__link:is(:hover, :focus-visible) .end__dir :global(.arrow) {
    translate: 4px 0;
  }

  .end__title {
    display: block;
    overflow-wrap: anywhere;
  }

  .end__date {
    color: var(--ink-soft);
  }

  .end__all {
    margin: clamp(2rem, 1.5rem + 2vw, 3.5rem) 0 0;
  }
</style>
