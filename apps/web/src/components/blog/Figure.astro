---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * An image with a mono caption. `src` is an imported image (`import shot from
 * '../../assets/posts/<slug>/shot.jpg'`) so it goes through Astro's image pipeline, or a
 * plain URL string (then give `width` and `height` to avoid layout shift). `wide` lets the
 * figure grow to 920px on desktop. The caption is the `caption` prop or the slot (use the
 * slot for links or emphasis). An empty `alt` marks the image as decorative.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string | undefined;
  wide?: boolean;
  width?: number | undefined;
  height?: number | undefined;
  class?: string;
}

const { src, alt, caption, wide = false, width, height, class: className } = Astro.props;
const hasCaption = Boolean(caption) || Astro.slots.has('default');
const sizes = wide
  ? '(min-width: 960px) 920px, calc(100vw - 2rem)'
  : '(min-width: 760px) 680px, calc(100vw - 2rem)';
---

<figure class:list={['figure', { 'figure--wide': wide }, className]} data-reveal="rise">
  <div class="figure__frame">
    {typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[480, 680, 960, 1400, 1840]}
        sizes={sizes}
        loading="lazy"
      />
    )}
  </div>
  {hasCaption && (
    <figcaption class="figure__caption">
      {caption}
      <slot />
    </figcaption>
  )}
</figure>
