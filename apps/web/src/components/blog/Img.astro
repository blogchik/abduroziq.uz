---
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

/**
 * The `img` of Markdown images (`![alt](./shot.jpg)`) in MDX posts. A markdown image that
 * Astro resolved to image metadata goes through the image pipeline; a title becomes the
 * caption. Use `<Figure>` for wide images and richer captions.
 */
interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
  width?: number | undefined;
  height?: number | undefined;
}

const { src, alt = '', title, width, height } = Astro.props;
---

<Figure src={src} alt={alt} caption={title} width={width} height={height} />
