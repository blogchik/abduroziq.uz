---
import { localePath, locales, t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  /** Where the language switch points, per locale (site-relative paths). */
  switchHrefs: Record<Locale, string>;
}

const { locale, switchHrefs } = Astro.props;
---

<header class="flex items-center justify-between gap-4 p-4">
  <a href={localePath(locale, '/')} class="font-mono text-xs uppercase">
    abduroziq.uz
  </a>
  <nav
    aria-label={t(locale, 'common.nav.label')}
    class="flex items-center gap-4 font-mono text-xs uppercase"
  >
    <a href={`${localePath(locale, '/')}#building`}>{t(locale, 'common.nav.building')}</a>
    <a href={localePath(locale, '/blog/')}>{t(locale, 'common.nav.writing')}</a>
    <span aria-label={t(locale, 'common.lang.label')} class="flex gap-2">
      {locales.map((target) => (
        <a
          href={switchHrefs[target]}
          hreflang={target}
          lang={target}
          aria-current={target === locale ? 'true' : undefined}
          class={target === locale ? 'text-ink' : 'text-ink-soft'}
        >
          {t(locale, `common.lang.${target}`)}
        </a>
      ))}
    </span>
  </nav>
</header>
