---
import { profile } from '@abduroziq/content';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { t, type Locale } from '@/i18n';
import { getPostByKey } from '@/lib/posts';
import Desk from './desk/Desk.astro';

/**
 * `01 — About` (DESIGN 4.3): the label in the left columns, two paragraphs in `lead` (key
 * phrases in ink, connecting words in ink-soft: who he is and what he builds, then how he
 * works with AI agents) and the facts as a hairline list of mono labels and body values.
 *
 * Under the paragraphs sits one quiet arrow link to the post about building the site
 * (`profile.aboutPost`, a `translationKey`). It exists only while that post is published,
 * in the page's language or else in the other one (then marked with `hreflang`). The text
 * reads complete without it and nothing else in the layout depends on it.
 *
 * Next to the paragraphs lies the collage: the polaroid, the sticky note and the piala,
 * tilted and overlapping, to pick up and throw (the motion kit's desk). On wide screens it
 * fills the column under the label; on smaller ones it is a band under the paragraphs. Both
 * are in the markup and CSS shows one.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const post = await getPostByKey(locale, profile.aboutPost);
---

<Container as="section" grid class="about" id="about" aria-labelledby="about-title">
  <SectionLabel
    as="h2"
    number={1}
    name={t(locale, 'home.about.title')}
    id="about-title"
    class="about__label"
    data-reveal="fade"
  />

  <div class="about__body">
    {profile.about[locale].map((paragraph) => (
      <p class="about__text type-lead" data-reveal="lines">
        {paragraph.map((span) => (span.strong ? <strong>{span.text}</strong> : span.text))}
      </p>
    ))}

    {post && (
      <p class="about__more" data-reveal="fade">
        <ArrowLink
          href={post.url}
          label={t(locale, 'home.about.post')}
          {...(post.locale === locale ? {} : { hreflang: post.locale })}
        />
      </p>
    )}

    <Desk locale={locale} variant="about-band" entrance={0.2} class="about__band" />

    <dl class="about__facts" data-reveal-group>
      {profile.facts.map((fact) => (
        <div class="about__fact" data-reveal-item>
          <dt class="type-label">{fact.label[locale]}</dt>
          <dd class="type-body">{fact.value[locale]}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="about__collage">
    <Desk locale={locale} variant="about" entrance={0.2} />
  </div>
</Container>

<style>
  .about {
    padding-block-start: var(--section);
    row-gap: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
  }

  .about :global(.about__label) {
    grid-column: 1 / -1;
    align-self: start;
  }

  .about__body {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .about__text {
    margin: 0;
    color: var(--ink-soft);
  }

  .about__text + .about__text {
    margin-block-start: 1em;
  }

  .about__text strong {
    color: var(--ink);
    font-weight: inherit;
  }

  /* The same air as the hero's action link. */
  .about__more {
    margin: clamp(1.5rem, 1.25rem + 1.1vw, 2.25rem) 0 0;
  }

  .about :global(.about__band) {
    margin-block-start: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
  }

  .about__collage {
    display: none;
  }

  .about__facts {
    margin: clamp(2.5rem, 1.9rem + 2.6vw, 4.25rem) 0 0;
  }

  .about__fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding-block: 0.9rem;
    border-block-start: var(--hairline) solid var(--rule);
  }

  .about__fact:last-child {
    border-block-end: var(--hairline) solid var(--rule);
  }

  .about__fact dt {
    color: var(--ink-soft);
  }

  .about__fact dd {
    margin: 0;
  }

  @media (width >= 40rem) {
    /* Label and value on one line; the label is centred on the value's first line. */
    .about__fact {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: baseline;
      padding-block: 1.05rem;
    }

    .about__fact dt {
      grid-column: span 2;
    }

    .about__fact dd {
      grid-column: span 6;
    }
  }

  @media (width >= 64rem) {
    /* The label's row is as high as the label; the collage takes the rest of the column. */
    .about {
      grid-template-rows: auto 1fr;
    }

    /* The label stands on the baseline of the paragraph's first line. */
    .about :global(.about__label) {
      grid-column: 1 / span 3;
      grid-row: 1;
      padding-block-start: calc(var(--fs-lead) * 0.941 - var(--fs-label) * 0.917);
    }

    .about__body {
      grid-column: 4 / span 8;
      grid-row: 1 / span 2;
    }

    .about__collage {
      display: block;
      grid-column: 1 / span 3;
      grid-row: 2;
      min-width: 0;
    }

    .about :global(.about__band) {
      display: none;
    }
  }
</style>
