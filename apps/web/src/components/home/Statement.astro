---
import { profile, type SentencePart } from '@abduroziq/content';
import Capsule from '@/components/ui/Capsule.astro';
import type { Locale } from '@/i18n';

/**
 * The statement (DESIGN 4.1): the `h1` of the page, set in `type-statement`: one plain
 * sentence with a single living thing in it, the eyes after the name.
 *
 * The eyes are a drawn stand-in for the author: two eyes on an accent pill, as tall as a
 * capital letter and standing on the baseline, so they never change the height of a line.
 * They follow the pointer, look around on their own, blink and wink when clicked
 * (`eyes.ts`); without JavaScript they glance at the name beside them. They are decoration,
 * hidden from assistive technology, so the text of the heading is the plain sentence.
 *
 * Spaces come from the content strings only (`compressHTML` would remove whitespace written
 * between inline elements in the template). The eyes stay on one line with the name before
 * them and the comma after them.
 */
interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id } = Astro.props;

// Words: the parts between two spaces. The eyes belong to the word they touch.
const words: SentencePart[][] = [[]];
for (const part of profile.sentence[locale]) {
  if (part.kind !== 'text') {
    words.at(-1)?.push(part);
    continue;
  }
  part.value.split(' ').forEach((piece, index) => {
    if (index > 0) words.push([]);
    if (piece) words.at(-1)?.push({ kind: 'text', value: piece });
  });
}
---

<h1 class="statement type-statement" id={id} data-hero-statement>
  {words.map((word, index) => {
    const nodes = word.map((part, i) => {
      if (part.kind === 'text') return part.value;
      // A word space towards the word before, none towards the punctuation after.
      const prev = word[i - 1];
      const spaced = prev?.kind === 'text' && /[\p{L}\p{N}]$/u.test(prev.value);
      return (
        <span
          class:list={['statement__eyes', { 'statement__eyes--spaced': spaced }]}
          data-hero-eyes
        >
          <Capsule tone="accent" class="capsule-eyes">
            <span class="eyes" data-eyes data-cursor="link">
              <span class="eye" data-eye>
                <span class="eye__pupil" />
              </span>
              <span class="eye" data-eye>
                <span class="eye__pupil" />
              </span>
            </span>
          </Capsule>
        </span>
      );
    });
    const plain = word.length === 1 && word[0]?.kind === 'text';
    return [index > 0 ? ' ' : '', plain ? nodes : <span class="statement__keep">{nodes}</span>];
  })}
</h1>

<style is:global>
  .statement {
    /* Three lines in both languages from tablets up, where this measure is the whole content
       width (`--fs-statement` is derived from it). The longest line is 16.6em. */
    max-width: min(17.3em, 100%);
    margin: 0;
  }

  /* There the lines break where the sentence does: who, what, from where to where. Phones
     keep the balanced wrapping of the type style. */
  @media (width >= 48rem) {
    .statement {
      text-wrap: wrap;
    }
  }

  .statement__keep {
    white-space: nowrap;
  }

  /* -------------------------------------------------------------------- eyes */

  .statement__eyes {
    position: relative;
    display: inline-block;
    width: 1.42em;
    /* From just under the baseline to just over the capitals (cap height 0.66em). */
    height: 0.74em;
    vertical-align: -0.04em;
    /* The entrance (hero.ts) pops the eyes from their centre. */
    transform-origin: 50% 60%;
  }

  /* The word space to the name (a space is about 0.2em). */
  .statement__eyes--spaced {
    margin-inline-start: 0.2em;
  }

  /* The capsule primitive fills the chip instead of setting its own size on the line. */
  .statement__eyes .capsule.capsule-eyes {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    /* Physical tones: the whites stay light and the pupils dark in both themes. */
    --eye-white: var(--paper-raised);
    --eye-ink: var(--ink);
  }

  @supports (color: light-dark(#000, #fff)) {
    .statement__eyes .capsule.capsule-eyes {
      --eye-white: light-dark(var(--paper-raised), var(--inv-paper-raised));
      --eye-ink: light-dark(var(--ink), var(--inv-ink));
    }
  }

  /* The capsule lays its child out as a block; the eyes need a centred row. */
  .capsule.capsule-eyes > .eyes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.06em;
    transition: scale var(--dur-2) var(--ease-out);
  }

  .capsule-eyes:hover .eyes {
    scale: 1.1;
  }

  .eye {
    /* How far a pupil travels from the centre of its eye. */
    --travel: 0.125em;
    position: relative;
    display: block;
    flex: none;
    width: 0.47em;
    height: 0.47em;
    border-radius: 50%;
    background-color: var(--eye-white);
  }

  /* Without JavaScript (and under reduced motion) the eyes glance at the name beside them;
     eyes.ts moves `--look-x` / `--look-y` between -1 and 1. */
  .eye__pupil {
    position: absolute;
    inset: 0;
    width: 0.21em;
    height: 0.21em;
    margin: auto;
    border-radius: 50%;
    background-color: var(--eye-ink);
    translate: calc(var(--look-x, -0.6) * var(--travel)) calc(var(--look-y, 0.15) * var(--travel));
    transition: translate var(--dur-1) var(--ease-out);
  }

  /* Wandering on their own, the eyes move slowly. */
  .eyes[data-idle] .eye__pupil {
    transition-duration: var(--dur-3);
  }

  @keyframes eye-blink {
    0%,
    93%,
    100% {
      scale: 1 1;
    }

    96.5% {
      scale: 1 0.06;
    }
  }

  html[data-motion='full'] .eye {
    animation: eye-blink 5.4s ease-in-out 1.6s infinite;
  }

  /* Nothing in the hero animates while it is off screen (hero.ts sets the attribute). */
  [data-hero][data-offscreen] .eye {
    animation-play-state: paused;
  }

  /* A click winks the right eye. */
  html[data-motion='full'] .eyes[data-wink] .eye:last-child {
    animation: none;
    scale: 1 0.06;
  }
</style>
