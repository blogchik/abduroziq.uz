---
import { profile, type SentencePart } from '@abduroziq/content';
import type { Locale } from '@/i18n';
import { starPath } from './meeting/field';
import StatementChip from './StatementChip.astro';

/**
 * The statement (DESIGN 4.1): the `h1` of the page, set in `type-statement`, with living
 * things inside the sentence: three chips on the line (StatementChip.astro), one letter
 * drawn as a turning starburst and one word circled by hand.
 *
 * The text of the heading is the plain sentence. The chips carry no text, the starburst
 * only covers its letter (which stays in the markup, unseen), and the ring is a drawing
 * behind its word. Spaces come from the content strings only (`compressHTML` would remove
 * whitespace written between inline elements in the template).
 *
 * Everything between two spaces stays on one line: a chip never parts from the word it
 * belongs to or from the comma after it, and a word is never broken at its starburst.
 */
interface Props {
  locale: Locale;
  id?: string;
}

type Word = SentencePart[];

const { locale, id } = Astro.props;

// Words: the parts between two spaces. Text is cut at its spaces; a circled phrase, a chip
// and a star letter are never cut.
const words: Word[] = [[]];
for (const part of profile.sentence[locale]) {
  if (part.kind !== 'text' || part.ring) {
    words.at(-1)?.push(part);
    continue;
  }
  part.value.split(' ').forEach((piece, index) => {
    if (index > 0) words.push([]);
    if (piece) words.at(-1)?.push({ kind: 'text', value: piece });
  });
}

/**
 * The ring: one loop of a pen around a box `aspect` times as wide as it is high. It starts
 * at the left, runs over the top and around, drifts outwards and overshoots its start.
 */
function ringPath(aspect: number): { width: number; d: string } {
  const height = 100;
  const width = Math.round(height * aspect);
  const points: [number, number][] = [];
  const steps = 30;
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const angle = ((-172 + 404 * t) * Math.PI) / 180;
    const drift = 0.9 + 0.1 * t + 0.022 * Math.sin(t * 9 + 1);
    points.push([
      width / 2 + Math.cos(angle) * (width / 2 - 5) * drift,
      height / 2 + Math.sin(angle) * (height / 2 - 6) * (drift - 0.03 * Math.cos(t * 7)),
    ]);
  }
  // A smooth curve through the points (Catmull-Rom as cubic Béziers).
  const at = (i: number): [number, number] =>
    points[Math.min(points.length - 1, Math.max(0, i))] ?? [0, 0];
  let d = `M${at(0)[0].toFixed(1)} ${at(0)[1].toFixed(1)}`;
  for (let i = 0; i < points.length - 1; i++) {
    const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1.map((v) => v.toFixed(1)).join(' ')} ${c2.map((v) => v.toFixed(1)).join(' ')} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return { width, d };
}

/** Rough width of a word in em of the statement (Bricolage 500 with its tight tracking). */
const emWidth = (text: string): number =>
  [...text].reduce(
    (sum, ch) => sum + (/[iljtfr.,:;'! ]/.test(ch) ? 0.3 : /[mwMW]/.test(ch) ? 0.84 : 0.535),
    0,
  );

/** The ring's box: the word plus 0.3em on each side, 1.14em high. */
const RING = { padX: 0.3, height: 1.14 };
const star = starPath(10);
---

<h1 class="statement type-statement" id={id} data-hero-statement>
  {words.map((word, index) => {
    const nodes = word.map((part, i) => {
      if (part.kind === 'chip') {
        // A word space towards a word, none towards punctuation.
        const prev = word[i - 1];
        const next = word[i + 1];
        const before = prev?.kind === 'text' && /[\p{L}\p{N}]$/u.test(prev.value);
        const after = next?.kind === 'text' && /^[\p{L}\p{N}]/u.test(next.value);
        return <StatementChip id={part.id} before={before} after={after} />;
      }
      if (part.kind === 'star') {
        return (
          <span class="star-o">
            <span class="star-o__letter">{part.value}</span>
            <svg class="star-o__burst" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
              <path d={star} />
            </svg>
          </span>
        );
      }
      if (part.ring) {
        const ring = ringPath((emWidth(part.value) + RING.padX * 2) / RING.height);
        return (
          <span class="circled">
            {part.value}
            <svg
              class="circled__ring"
              viewBox={`0 0 ${ring.width} 100`}
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <path d={ring.d} pathLength="1" data-hero-ring />
            </svg>
          </span>
        );
      }
      return part.value;
    });
    const plain = word.length === 1 && word[0]?.kind === 'text' && !word[0].ring;
    return [index > 0 ? ' ' : '', plain ? nodes : <span class="statement__keep">{nodes}</span>];
  })}
</h1>

<style is:global>
  .statement {
    /* Four lines in both languages; about nine of the twelve columns on a desktop. */
    max-width: min(13.6em, 100%);
    margin: 0;
  }

  .statement__keep {
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------- the ring */

  .circled {
    position: relative;
    display: inline-block;
  }

  /* Around the word: from above the ascenders to below the descenders, and into the word
     spaces on both sides. Nearly the same proportions as its viewBox, so the line keeps one
     thickness; a slight turn, as a hand would draw it. */
  .circled__ring {
    position: absolute;
    top: -0.05em;
    left: -0.3em;
    width: calc(100% + 0.6em);
    height: calc(100% + 0.12em);
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    rotate: -2.5deg;
    pointer-events: none;
  }

  /* One dash as long as the path: hero.ts draws it by sliding the dash in. */
  .circled__ring path {
    stroke-dasharray: 1;
  }

  /* ---------------------------------------------------------- the star letter */

  .star-o {
    position: relative;
    display: inline-block;
  }

  /* The letter keeps its place in the line and in the text; it is just not painted. */
  .star-o__letter {
    opacity: 0;
  }

  /* Centred on the letter: half the x-height (0.49em) above the baseline, which lies 0.84em
     under the top of the line box. */
  .star-o__burst {
    position: absolute;
    top: 0.595em;
    left: 50%;
    width: 0.66em;
    height: 0.66em;
    margin: -0.33em 0 0 -0.33em;
    overflow: visible;
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    pointer-events: none;
  }

  @keyframes star-turn {
    to {
      rotate: 360deg;
    }
  }

  html[data-motion='full'] .star-o__burst {
    animation: star-turn 18s linear infinite;
  }

  [data-hero][data-offscreen] .star-o__burst {
    animation-play-state: paused;
  }

  @media (forced-colors: active) {
    .circled__ring {
      stroke: Highlight;
    }

    .star-o__burst {
      fill: Highlight;
      stroke: Highlight;
    }
  }
</style>
