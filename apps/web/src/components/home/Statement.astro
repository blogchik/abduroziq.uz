---
import { profile, type SentencePart } from '@abduroziq/content';
import Capsule from '@/components/ui/Capsule.astro';
import type { Locale } from '@/i18n';

/**
 * The statement (DESIGN 4.1): the `h1` of the page, set in `type-statement`: one plain
 * sentence in two tones with a single living thing in it, the capsule after the name.
 *
 * The tones: who he is stays in the ink, what follows (`quiet` parts of the content) steps
 * back into the soft ink, so the eye lands on the name and the role first.
 *
 * The capsule is an accent pill, as tall as a capital letter and standing on the baseline,
 * so it never changes the height of a line. It rolls through four drawn glyphs: design (a
 * selection frame), code (`</>`), production (a rocket) and a smile. The roll is one CSS
 * loop that runs only with full motion and while the hero is on screen; otherwise the pill
 * shows the first glyph. It is decoration, hidden from assistive technology, so the text of
 * the heading is the plain sentence.
 *
 * Spaces come from the content strings only (`compressHTML` would remove whitespace written
 * between inline elements in the template). The capsule stays on one line with the name
 * before it and the comma after it.
 */
interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id } = Astro.props;

// Words: the parts between two spaces. The capsule belongs to the word it touches.
const words: SentencePart[][] = [[]];
for (const part of profile.sentence[locale]) {
  if (part.kind !== 'text') {
    words.at(-1)?.push(part);
    continue;
  }
  part.value.split(' ').forEach((piece, index) => {
    if (index > 0) words.push([]);
    if (piece) words.at(-1)?.push({ ...part, value: piece });
  });
}

// Runs: neighbouring words of one tone. A quiet run is a single element.
const runs: { quiet: boolean; words: SentencePart[][] }[] = [];
for (const word of words) {
  if (word.length === 0) continue;
  const quiet = word.every((part) => part.kind === 'text' && part.quiet === true);
  const last = runs.at(-1);
  if (last?.quiet === quiet) last.words.push(word);
  else runs.push({ quiet, words: [word] });
}

const plainText = (word: SentencePart[]): string =>
  word.map((part) => (part.kind === 'text' ? part.value : '')).join('');

/**
 * What the capsule rolls through, drawn like the site's arrow (square caps, mitred joins)
 * on a 24 unit grid. The keyframes below count on four of them.
 */
const glyphs: { name: string; line: string; solid?: string; rotate?: number }[] = [
  {
    // Design: a selection frame and its four handles.
    name: 'design',
    line: 'M6 6h12v12H6z',
    solid: 'M3.5 3.5h5v5h-5zM15.5 3.5h5v5h-5zM3.5 15.5h5v5h-5zM15.5 15.5h5v5h-5z',
  },
  {
    // Code: </>
    name: 'code',
    line: 'M8.5 6.5 3 12l5.5 5.5M15.5 6.5 21 12l-5.5 5.5M13.75 4.5l-3.5 15',
  },
  {
    // Production: a rocket on its way up.
    name: 'ship',
    line: 'M12 2.5c3 2.5 4 6 4 9.5v4H8v-4c0-3.5 1-7 4-9.5zM8 12l-3 3.5v3h3M16 12l3 3.5v3h-3M12 18.75v2.75M12 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z',
    rotate: 45,
  },
  {
    // And a smile.
    name: 'smile',
    line: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM9 9v2M15 9v2M7.9 14c1 1.6 2.4 2.5 4.1 2.5s3.1-.9 4.1-2.5',
  },
];
// The first glyph again at the end: the loop restarts on the picture it ends with.
const slides = [...glyphs, ...glyphs.slice(0, 1)];
---

<h1 class="statement type-statement" id={id} data-hero-statement>
  {runs.map((run, r) => [
    r > 0 ? ' ' : '',
    run.quiet ? (
      <span class="statement__quiet">{run.words.map(plainText).join(' ')}</span>
    ) : (
      run.words.map((word, w) => {
        const nodes = word.map((part, i) => {
          if (part.kind === 'text') {
            return part.quiet ? <span class="statement__quiet">{part.value}</span> : part.value;
          }
          // A word space towards the word before, none towards the punctuation after.
          const prev = word[i - 1];
          const spaced = prev?.kind === 'text' && /[\p{L}\p{N}]$/u.test(prev.value);
          return (
            <span
              class:list={['statement__capsule', { 'statement__capsule--spaced': spaced }]}
              data-hero-capsule
            >
              <Capsule tone="accent" class="capsule-roll">
                <span class="roll">
                  {slides.map((glyph) => (
                    <span class="roll__slide" data-glyph={glyph.name}>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"
                        stroke-linejoin="miter"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <g transform={glyph.rotate ? `rotate(${glyph.rotate} 12 12)` : undefined}>
                          <path d={glyph.line} />
                          {glyph.solid && (
                            <path d={glyph.solid} fill="currentColor" stroke="none" />
                          )}
                        </g>
                      </svg>
                    </span>
                  ))}
                </span>
              </Capsule>
            </span>
          );
        });
        const plain = word.length === 1 && word[0]?.kind === 'text' && !word[0].quiet;
        return [w > 0 ? ' ' : '', plain ? nodes : <span class="statement__keep">{nodes}</span>];
      })
    ),
  ])}
</h1>

<style is:global>
  .statement {
    /* Three lines in both languages from tablets up, where this measure is the whole content
       width (`--fs-statement` is derived from it). The longest line is 16.6em. */
    max-width: min(17.3em, 100%);
    margin: 0;
  }

  /* There the lines break where the sentence does: who, what, from where to where. Phones
     keep the balanced wrapping of the type style. */
  @media (width >= 48rem) {
    .statement {
      text-wrap: wrap;
    }
  }

  .statement__keep {
    white-space: nowrap;
  }

  /* The second tone: everything after the name and the role (AA on paper in both themes). */
  .statement__quiet {
    color: var(--ink-soft);
  }

  /* ----------------------------------------------------------------- capsule */

  .statement__capsule {
    position: relative;
    display: inline-block;
    width: 1.3em;
    /* From just under the baseline to just over the capitals (cap height 0.66em). */
    height: 0.74em;
    vertical-align: -0.04em;
    /* The entrance (hero.ts) pops the capsule from its centre. */
    transform-origin: 50% 60%;
  }

  /* The word space to the name (a space is about 0.2em). */
  .statement__capsule--spaced {
    margin-inline-start: 0.2em;
  }

  /* The capsule primitive fills the chip instead of setting its own size on the line. */
  .statement__capsule .capsule.capsule-roll {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    /* The accent is the same in both themes, and so is the ink drawn on it. */
    color: var(--on-accent);
  }

  /* The track: one slide per glyph, each as tall as the pill, stacked. */
  .capsule.capsule-roll > .roll {
    display: flex;
    flex-direction: column;
    height: 500%;
  }

  .roll__slide {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .roll__slide svg {
    display: block;
    flex: none;
    width: auto;
    height: 70%;
    aspect-ratio: 1;
    overflow: visible;
  }

  /* Four glyphs, each held for about two seconds and rolled away in half a second. The
     fifth slide repeats the first, so the loop restarts unseen. */
  @keyframes capsule-roll {
    0%,
    19.8% {
      translate: 0 0;
    }

    25%,
    44.8% {
      translate: 0 -20%;
    }

    50%,
    69.8% {
      translate: 0 -40%;
    }

    75%,
    94.8% {
      translate: 0 -60%;
    }

    100% {
      translate: 0 -80%;
    }
  }

  html[data-motion='full'] .capsule-roll > .roll {
    /* A small overshoot: the glyph lands like a counter wheel. */
    animation: capsule-roll 9.6s cubic-bezier(0.6, 0, 0.2, 1.25) 0.4s infinite;
  }

  /* Nothing in the hero animates while it is off screen (hero.ts sets the attribute). */
  [data-hero][data-offscreen] .capsule-roll > .roll {
    animation-play-state: paused;
  }
</style>
