---
import { profile, type SentencePart } from '@abduroziq/content';
import type { Locale } from '@/i18n';
import SentenceCapsule from './SentenceCapsule.astro';

/**
 * The sentence (DESIGN 4.1): the `h1` of the page, set in `type-sentence`, with three
 * living capsules between the words (SentenceCapsule.astro). The capsules are decorative,
 * so the heading reads as plain text: "I'm Abduroziq, a Product Engineer based in Tashkent".
 *
 * A capsule never starts a line and is never torn from the comma after it: each one is
 * kept together with the word before it (and any punctuation that follows) in a group that
 * does not wrap. The space between the word and its capsule is drawn as a margin, not
 * written as a character, so the text of the heading has no stray space before a comma.
 * Every other space comes from the content strings (`compressHTML` would remove whitespace
 * written between inline elements in the template).
 */
interface Props {
  locale: Locale;
}

type Inline = Exclude<SentencePart, { kind: 'break' }>;
type Node = SentencePart | { kind: 'keep'; spaced: boolean; children: Inline[] };

const { locale } = Astro.props;

const nodes: Node[] = [];
const source = profile.sentence[locale].map((part) => ({ ...part }));

source.forEach((part, index) => {
  if (part.kind !== 'capsule') {
    if (part.kind === 'break' || part.value !== '') nodes.push(part);
    return;
  }
  const group: Inline[] = [part];

  // The word before the capsule, across a separating space.
  let last = nodes.at(-1);
  let spaced = false;
  if (last?.kind === 'text' && last.value.trim() === '') {
    nodes.pop();
    spaced = true;
    last = nodes.at(-1);
  }
  if (last?.kind === 'em') {
    nodes.pop();
    group.unshift(last);
  } else if (last?.kind === 'text') {
    const match = /^(.*?)(\S+)(\s*)$/s.exec(last.value);
    if (match) {
      const [, before = '', word = '', gap = ''] = match;
      if (before) last.value = before;
      else nodes.pop();
      spaced ||= gap !== '';
      group.unshift({ kind: 'text', value: word });
    }
  }

  // Punctuation right after the capsule.
  const next = source[index + 1];
  if (next?.kind === 'text') {
    const lead = /^\S+/.exec(next.value)?.[0];
    if (lead) {
      group.push({ kind: 'text', value: lead });
      next.value = next.value.slice(lead.length);
    }
  }
  nodes.push({ kind: 'keep', spaced, children: group });
});
---

<h1 class="sentence type-sentence" data-hero-sentence>
  {nodes.map((node) => {
    if (node.kind === 'keep') {
      return (
        <span class:list={['sentence__keep', { 'sentence__keep--spaced': node.spaced }]}>
          {node.children.map((child) =>
            child.kind === 'capsule' ? (
              <SentenceCapsule id={child.id} />
            ) : child.kind === 'em' ? (
              <em>{child.value}</em>
            ) : (
              child.value
            ),
          )}
        </span>
      );
    }
    if (node.kind === 'break') return <br />;
    if (node.kind === 'capsule') return <SentenceCapsule id={node.id} />;
    return node.kind === 'em' ? <em>{node.value}</em> : node.value;
  })}
</h1>

<style is:global>
  .sentence__keep {
    white-space: nowrap;
  }

  /* The word space before a capsule (a space of the serif is about 0.22em wide). */
  .sentence__keep--spaced [data-capsule] {
    margin-inline-start: 0.32em;
  }

  /* The capsules are rendered by a primitive, so their insides are styled globally. */

  /* ---------------------------------------------------------------- portrait */
  .capsule-portrait img {
    /* The face sits near 56% / 35% of the square photo; the pill shows a 2:1 window. */
    object-position: 56% 27%;
    scale: 1.35;
    transform-origin: 56% 36%;
  }

  /* ------------------------------------------------------------------- craft */
  .craft {
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: max(1.25px, 0.021em);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .craft path,
  .craft rect {
    vector-effect: non-scaling-stroke;
  }

  .craft__handles rect {
    fill: var(--paper);
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  .craft__edge {
    transform-origin: 24px 12.5px;
  }

  .craft__arm--lu,
  .craft__arm--ld {
    transform-origin: 13px 12.5px;
  }

  .craft__arm--ru,
  .craft__arm--rd {
    transform-origin: 35px 12.5px;
  }

  .craft__slash {
    transform-origin: 24px 12.5px;
    opacity: 0;
  }

  /* The still drawing (reduced motion): the frame with a small `</>` inside it. */
  .craft__still {
    opacity: 0;
  }

  :root[data-motion='reduced'] .craft__still {
    opacity: 1;
  }

  /* One loop: frame, turn into code, hold, turn back. Transform and opacity only. */
  :root:not([data-motion='reduced'])
    .craft
    :is(.craft__edge, .craft__arm, .craft__side, .craft__slash),
  :root:not([data-motion='reduced']) .craft__handles rect {
    animation-duration: 5.6s;
    animation-timing-function: var(--ease-in-out);
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }

  :root:not([data-motion='reduced']) .craft__edge {
    animation-name: craft-edge;
  }

  :root:not([data-motion='reduced']) .craft__handles rect {
    animation-name: craft-handle;
  }

  :root:not([data-motion='reduced']) .craft__slash {
    animation-name: craft-slash;
  }

  :root:not([data-motion='reduced']) :is(.craft__arm--lu, .craft__arm--rd) {
    animation-name: craft-arm-cw;
  }

  :root:not([data-motion='reduced']) :is(.craft__arm--ld, .craft__arm--ru) {
    animation-name: craft-arm-ccw;
  }

  :root:not([data-motion='reduced']) .craft__side--left {
    animation-name: craft-side-left;
  }

  :root:not([data-motion='reduced']) .craft__side--right {
    animation-name: craft-side-right;
  }

  /* Paused while the hero is off screen (hero.ts sets the attribute). */
  [data-hero][data-offscreen] .craft * {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .craft__still {
      opacity: 1;
    }
  }

  @keyframes craft-edge {
    0%,
    34% {
      opacity: 1;
      transform: scaleX(1);
    }

    44%,
    88% {
      opacity: 0;
      transform: scaleX(0.2);
    }

    98%,
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes craft-handle {
    0%,
    32% {
      transform: scale(1);
    }

    40%,
    90% {
      transform: scale(0);
    }

    98%,
    100% {
      transform: scale(1);
    }
  }

  @keyframes craft-slash {
    0%,
    38% {
      opacity: 0;
      transform: scale(0.2);
    }

    48%,
    86% {
      opacity: 1;
      transform: scale(1);
    }

    94%,
    100% {
      opacity: 0;
      transform: scale(0.2);
    }
  }

  @keyframes craft-arm-cw {
    0%,
    34% {
      transform: rotate(0deg);
    }

    46%,
    88% {
      transform: rotate(42deg);
    }

    98%,
    100% {
      transform: rotate(0deg);
    }
  }

  @keyframes craft-arm-ccw {
    0%,
    34% {
      transform: rotate(0deg);
    }

    46%,
    88% {
      transform: rotate(-42deg);
    }

    98%,
    100% {
      transform: rotate(0deg);
    }
  }

  @keyframes craft-side-left {
    0%,
    34% {
      transform: translateX(0);
    }

    46%,
    88% {
      transform: translateX(2px);
    }

    98%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes craft-side-right {
    0%,
    34% {
      transform: translateX(0);
    }

    46%,
    88% {
      transform: translateX(-2px);
    }

    98%,
    100% {
      transform: translateX(0);
    }
  }

  /* --------------------------------------------------------------------- sky */
  /* Paper-light by day, ink-dark by night, accent for the half hour around sunrise and
     sunset. Light and dark here are the physical tones (the same in both themes). Without
     JavaScript the capsule shows a plain day sky with the sun at noon. */
  .sky {
    --sky-bg: var(--desk-paper, var(--paper-raised));
    --sky-line: var(--desk-ink, var(--ink));
    --sky-body: var(--accent);
    position: relative;
    background-color: var(--sky-bg);
  }

  [data-sky='night'] .sky {
    --sky-bg: var(--desk-ink, var(--ink));
    --sky-line: var(--desk-paper, var(--paper-raised));
    --sky-body: var(--desk-paper, var(--paper-raised));
  }

  [data-sky='dusk'] .sky {
    --sky-bg: var(--accent);
    --sky-line: var(--on-accent);
    --sky-body: var(--on-accent);
  }

  .sky__dot {
    position: absolute;
    top: calc(var(--sky-y, 24) * 1%);
    left: calc(var(--sky-x, 50) * 1%);
    width: 0.17em;
    height: 0.17em;
    border-radius: var(--radius-pill);
    background-color: var(--sky-body);
    translate: -50% -50%;
  }

  /* The moon: the same dot with a bite taken out of it. */
  [data-sky='night'] .sky__dot::after {
    content: '';
    position: absolute;
    inset: -18% -34% 18% 34%;
    border-radius: inherit;
    background-color: var(--sky-bg);
  }

  .sky__stars,
  .sky__stars::before,
  .sky__stars::after {
    position: absolute;
    width: max(1.5px, 0.022em);
    height: max(1.5px, 0.022em);
    border-radius: var(--radius-pill);
    background-color: var(--sky-line);
  }

  .sky__stars {
    top: 26%;
    left: 22%;
    display: none;
  }

  .sky__stars::before,
  .sky__stars::after {
    content: '';
  }

  .sky__stars::before {
    top: 0.14em;
    left: 0.42em;
  }

  .sky__stars::after {
    top: -0.06em;
    left: 0.9em;
  }

  [data-sky='night'] .sky__stars {
    display: block;
  }

  .sky__city {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--sky-line);
    stroke-width: max(1px, 0.014em);
    stroke-linejoin: round;
  }

  .sky__city path {
    vector-effect: non-scaling-stroke;
  }
</style>
