---
import { profile } from '@abduroziq/content';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { t, type Locale } from '@/i18n';
import { TASHKENT_UTC_OFFSET } from './lib';
import Meeting from './meeting/Meeting.astro';
import Statement from './Statement.astro';

/**
 * `00 — Hello` (DESIGN 4.1 and 4.2): two things to look at, in this order.
 *
 *  1. The statement: one plain sentence (the page's `h1`) with the eyes after the name, and
 *     one quiet action under it.
 *  2. The meeting: the thin name edge to edge, and in front of it the dotted graphic of two
 *     cursors about to touch. It is the visual centre of the first screen.
 *
 * Around them only the section label and, opposite it, one quiet line of meta: the city and
 * its time now.
 *
 * The statement and the action are painted with the first frame and never hidden or moved
 * (the sentence is the page's largest paint). Only decoration is held back by CSS, and only
 * while JavaScript and full motion are on, with a 2.5s failsafe: the eyes here (popped by
 * `hero.ts`), the picture and the tags of the meeting (`meeting.ts`), and the name, which
 * the motion kit reveals.
 *
 * The time is written by the inline script at the end of the section, before first paint,
 * and kept current by `hero.ts`. Without JavaScript the line shows the city and its zone.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zone = `UTC${TASHKENT_UTC_OFFSET >= 0 ? '+' : ''}${TASHKENT_UTC_OFFSET}`;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <Container class="hero__shell">
    <div class="hero__top">
      <SectionLabel number={0} name={t(locale, 'home.hero.label')} />
      <p class="hero__meta type-label">
        {profile.location.city[locale]} <span data-hero-clock></span> {zone}
      </p>
    </div>

    <Statement locale={locale} id="hero-title" />
    <p class="hero__action">
      <ArrowLink href="#contact" label={t(locale, 'home.hero.action')} direction="down" />
    </p>

    <div class="hero__meeting">
      <Meeting locale={locale} />
    </div>
  </Container>

  <script is:inline data-astro-rerun define:vars={{ offset: TASHKENT_UTC_OFFSET }}>
    // The time in Tashkent, written before first paint; `hero.ts` calls the same function
    // every minute.
    (() => {
      const paint = (hero) => {
        // Shifted so that the UTC getters read Tashkent wall-clock time.
        const time = new Date(Date.now() + offset * 36e5).toISOString().slice(11, 16);
        for (const el of hero.querySelectorAll('[data-hero-clock]')) {
          if (el.textContent !== time) el.textContent = time;
        }
      };
      window.__heroNow = paint;
      const hero =
        document.currentScript?.closest('[data-hero]') ?? document.querySelector('[data-hero]');
      if (hero) paint(hero);
    })();
  </script>
</section>

<script>
  import './hero';
  import './eyes';
</script>

<style>
  .hero {
    padding-block-start: clamp(1.25rem, 1rem + 1.1vw, 2rem);
  }

  /* The label, and opposite it the one line of meta. */
  .hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--col-gap);
  }

  .hero__meta {
    margin: 0;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .hero :global(.statement) {
    margin-block-start: clamp(1.5rem, 1.1rem + 1.8vw, 2.75rem);
  }

  .hero__action {
    margin: clamp(1.5rem, 1.25rem + 1.1vw, 2.25rem) 0 0;
  }

  /* Air above the picture: the eye goes to the statement first, then to the object. */
  .hero__meeting {
    margin-block-start: clamp(2.75rem, 2.1rem + 2.8vw, 4.5rem);
  }

  /* Short desktop screens (1280x720): a little less air, so that the statement, the action
     and the whole picture share the first screen. */
  @media (width >= 64rem) and (height <= 50rem) {
    .hero {
      padding-block-start: 0.75rem;
    }

    .hero :global(.statement) {
      margin-block-start: 1.5rem;
    }

    .hero__action {
      margin-block-start: 1.25rem;
    }

    .hero__meeting {
      margin-block-start: 1.75rem;
    }
  }

  /* --------------------------------------------------------------- entrance */

  /* The eyes wait for hero.ts (it sets `data-hero-ready` in the same task in which it
     applies their start pose); the words around them are painted at once. Never without
     JavaScript or under reduced motion. */
  :global(html.js[data-motion='full']) .hero:not([data-hero-ready]) :global([data-hero-eyes]) {
    opacity: 0;
    animation: m-failsafe 0.01s linear 2.5s forwards;
  }
</style>
