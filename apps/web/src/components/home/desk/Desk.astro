---
import { profile } from '@abduroziq/content';
import { locales, t, type Locale } from '@/i18n';
import DeskObject from './DeskObject.astro';
import Keycap from './Keycap.astro';
import Piala from './Piala.astro';
import Polaroid from './Polaroid.astro';
import StickyNote from './StickyNote.astro';

/**
 * A desk: objects that can be picked up and thrown, through the motion kit's desk contract.
 * Five layouts share the object components:
 *
 *  - `about`: the collage next to the About paragraph (DESIGN 4.3): the polaroid, the sticky
 *    note and the piala, tilted and overlapping, in the column under the section label.
 *  - `about-band`: the same three in a band of their own under the paragraph, on screens
 *    without that column.
 *  - `notfound`, `notfound-mid` and `notfound-band`: three objects to throw on the 404 page
 *    (DESIGN 6.4), over the whole ink band on wide screens (`notfound-mid` below 90rem, where
 *    the band is lower and the piala and the keycap move left of the text) and in a band of
 *    their own on small ones. The root 404 page may answer any locale's path, so its words
 *    are printed in each language (`data-nf-lang`, see NotFoundPage.astro).
 *
 * Decoration only: hidden from assistive technology, nothing in it is focusable.
 */
type Kind = 'sticky' | 'polaroid' | 'keycap' | 'piala';

interface Pose {
  kind: Kind;
  x: number;
  y: number;
  rotate: number;
}

interface Props {
  locale: Locale;
  variant: 'about' | 'about-band' | 'notfound' | 'notfound-mid' | 'notfound-band';
  /** Seconds before the objects drop in (the kit's `data-desk-entrance`). */
  entrance?: number;
  class?: string;
}

const { locale, variant, entrance, class: className } = Astro.props;

const layouts: Record<Props['variant'], Pose[]> = {
  // Poses keep the rotated corners inside the desk (the drag bounds count them): the
  // polaroid's stick out by 3% of the width and 1.7% of the height.
  about: [
    { kind: 'polaroid', x: 3.1, y: 1.8, rotate: -6 },
    { kind: 'sticky', x: 46, y: 23, rotate: 5 },
    { kind: 'piala', x: 4, y: 66, rotate: 0 },
  ],
  'about-band': [
    { kind: 'polaroid', x: 1, y: 3, rotate: -5 },
    { kind: 'sticky', x: 60, y: 1, rotate: 5 },
    { kind: 'piala', x: 31, y: 50, rotate: 0 },
  ],
  notfound: [
    { kind: 'sticky', x: 67, y: 7, rotate: 5 },
    { kind: 'piala', x: 87.5, y: 33, rotate: 0 },
    { kind: 'keycap', x: 64, y: 45, rotate: -10 },
  ],
  'notfound-mid': [
    { kind: 'sticky', x: 67, y: 7, rotate: 5 },
    { kind: 'piala', x: 37, y: 52, rotate: 0 },
    { kind: 'keycap', x: 20, y: 28, rotate: -10 },
  ],
  'notfound-band': [
    { kind: 'piala', x: 30, y: 14, rotate: 0 },
    { kind: 'sticky', x: 64, y: 3, rotate: 5 },
    { kind: 'keycap', x: 74, y: 70, rotate: -10 },
  ],
};

const notFound = variant.startsWith('notfound');
---

<div
  class:list={['desk', `desk--${variant}`, className]}
  data-desk
  data-desk-entrance={entrance}
  data-desk-variant={variant}
  aria-hidden="true"
>
  {layouts[variant].map((pose) => (
    <DeskObject kind={pose.kind} x={pose.x} y={pose.y} rotate={pose.rotate}>
      {pose.kind === 'sticky' &&
        (notFound ? (
          <StickyNote>
            {locales.map((lang) => (
              <span data-nf-lang={lang}>{t(lang, 'home.notFound.note')}</span>
            ))}
          </StickyNote>
        ) : (
          <StickyNote text={profile.desk.stickyNote} />
        ))}
      {pose.kind === 'polaroid' && <Polaroid caption={profile.desk.polaroidCaption} />}
      {pose.kind === 'keycap' && <Keycap legend={t(locale, 'home.notFound.keycap')} />}
      {pose.kind === 'piala' && (
        <>
          <Piala
            counterLabel={
              notFound
                ? Object.fromEntries(locales.map((lang) => [lang, t(lang, 'home.desk.cups')]))
                : t(locale, 'home.desk.cups')
            }
            refillLabel={t(locale, 'home.desk.refill')}
          />
          <span class="note note--piala">
            <span class="note__text type-hand">
              {notFound
                ? locales.map((lang) => (
                    <span data-nf-lang={lang}>{profile.desk.pialaNote[lang]}</span>
                  ))
                : profile.desk.pialaNote[locale]}
            </span>
            <svg class="note__arrow" viewBox="0 0 56 44" focusable="false">
              <path d="M4 4c10 2 22 10 20 20-2 8-12 6-9-2 3-8 20-4 34 14M47.5 27.1 49 36l-8.2-3.7" />
            </svg>
          </span>
        </>
      )}
    </DeskObject>
  ))}
</div>

<style>
  .desk {
    position: relative;
  }

  /* Objects are a little smaller where there is less room. */
  .desk--about {
    height: calc(28rem * var(--desk-k, 1));
  }

  /* A compact collage also where the band could be wide. */
  .desk--about-band {
    --desk-k: 0.82;
    max-width: 23rem;
    height: 310px;
  }

  .desk--notfound-band {
    --desk-k: 0.82;
    height: 240px;
  }

  @media (width < 90rem) {
    .desk--about {
      --desk-k: 0.86;
    }
  }

  @media (width < 80rem) {
    .desk--about {
      --desk-k: 0.7;
    }
  }

  /* Hand notes: pencil on the page, attached to their object. */
  .note {
    position: absolute;
    display: flex;
    align-items: flex-start;
    color: var(--ink-soft);
    pointer-events: none;
    white-space: nowrap;
  }

  .note__arrow {
    flex: none;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Left of the bowl, two short lines, the arrow looping into the bowl. */
  .note--piala {
    inset-block-start: calc(2px * var(--desk-k, 1));
    inset-inline-end: calc(100% - 10px);
    align-items: flex-start;
    gap: 2px;
  }

  .note--piala .note__text {
    max-width: 5.4em;
    text-align: end;
    white-space: normal;
    rotate: -6deg;
  }

  .note--piala .note__arrow {
    width: 46px;
    margin-block-start: 16px;
  }

  /* In the About collage the bowl lies at the left: its note stands to the right of it,
     the arrow mirrored. */
  :is(.desk--about, .desk--about-band) .note--piala {
    inset-inline: calc(100% - 8px) auto;
    flex-direction: row-reverse;
  }

  :is(.desk--about, .desk--about-band) .note--piala .note__text {
    text-align: start;
    rotate: 5deg;
  }

  :is(.desk--about, .desk--about-band) .note--piala .note__arrow {
    scale: -1 1;
  }
</style>
