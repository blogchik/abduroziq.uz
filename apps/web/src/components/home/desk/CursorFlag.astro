---
/** A multiplayer-style cursor with a name tag (DESIGN 4.2), in the accent. */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="flag">
  <svg class="flag__arrow" viewBox="0 0 20 22" aria-hidden="true" focusable="false">
    <path d="M2 1.5 8.3 20l2.6-7.9L18.5 9.3z"></path>
  </svg>
  <span class="flag__tag type-label desk-shadow">{name}</span>
</div>

<style>
  .flag {
    display: flex;
    align-items: flex-start;
  }

  .flag__arrow {
    flex: none;
    width: 20px;
    height: 22px;
    overflow: visible;
    fill: var(--accent);
    stroke: var(--on-accent);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* The corner next to the arrow stays square, as on a multiplayer name tag. */
  .flag__tag {
    margin-block-start: 15px;
    margin-inline-start: -3px;
    padding: 0.55em 0.95em 0.5em 0.8em;
    border-radius: 0 var(--radius-pill) var(--radius-pill) var(--radius-pill);
    background-color: var(--accent);
    color: var(--on-accent);
    text-transform: none;
    white-space: nowrap;
  }
</style>
