---
import { profile } from '@abduroziq/content';
import Barcode from '@/components/ui/Barcode.astro';

/**
 * The label strip under the name (DESIGN 4.1): an accent bar printed like a shipping label.
 * A paper box with barcode micro text, the handling instructions, the role, and the name
 * mark with `MADE IN TASHKENT` on the right. Decorative and in English in both locales
 * (the content says so), so it is hidden from assistive technology.
 *
 * `data-strip-part` marks the pieces that fade in after the strip has wiped in.
 */
const year = new Date().getFullYear();
const { lat, lon } = profile.location;
const serial = `${lat.toFixed(4)}N ${lon.toFixed(4)}E`;
---

<div class="strip surface-accent" data-hero-strip aria-hidden="true">
  <div class="strip__box" data-strip-part>
    <Barcode seed={profile.fullName} bars={46} height="100%" fill class="strip__bars" />
    <p class="strip__serial type-micro">
      <span>{profile.email.split('@')[1]}</span>
      <span class="strip__coords">{serial}</span>
    </p>
  </div>

  <p class="strip__text type-micro" data-strip-part>
    {profile.labelStrip.instructions}
  </p>
  <p class="strip__role type-label" data-strip-part>
    {profile.labelStrip.role}
  </p>

  <p class="strip__mark type-label" data-strip-part>
    {profile.name}©<span data-hero-year>{year}</span>
  </p>
  <p class="strip__made type-label" data-strip-part>
    <Barcode seed="made-in" bars={12} height="0.9em" module={2} class="strip__ticks" />
    <span>{profile.labelStrip.madeIn}</span>
  </p>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'box text mark'
      'box role made';
    column-gap: clamp(0.75rem, 0.4rem + 1.4vw, 1.75rem);
    height: 64px;
    padding: 7px;
    padding-inline-end: 12px;
  }

  .strip p {
    margin: 0;
  }

  /* The paper field of the label: a barcode and two lines of micro data. */
  .strip__box {
    grid-area: box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5px;
    width: clamp(4.25rem, 0.5rem + 16vw, 13.5rem);
    padding: 6px 7px 5px;
    /* A window onto the page: its paper, printed in the page's ink (the surface around it
       has remapped `--ink` to on-accent, so the dark theme takes the light tone by name). */
    background-color: var(--paper);
    color: var(--on-accent);
    color: light-dark(var(--on-accent), var(--inv-paper));
  }

  .strip__box :global(.strip__bars) {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
  }

  .strip__serial {
    display: none;
    justify-content: space-between;
    gap: 8px;
    white-space: nowrap;
  }

  .strip__coords {
    display: none;
  }

  /* At most four lines: what does not fit above the role is cut off, like a print that
     runs under a fold. */
  .strip__text {
    grid-area: text;
    display: none;
    max-width: 64ch;
    max-height: calc(1.25em * 4);
    margin-block-start: 2px;
    overflow: hidden;
    text-wrap: wrap;
  }

  .strip__role {
    grid-area: role;
    align-self: end;
    white-space: nowrap;
  }

  .strip__mark,
  .strip__made {
    justify-self: end;
    white-space: nowrap;
  }

  .strip__mark {
    grid-area: mark;
    padding-block-start: 2px;
  }

  .strip__made {
    grid-area: made;
    display: flex;
    align-items: center;
    align-self: end;
    gap: 1em;
  }

  .strip__made :global(.strip__ticks) {
    display: none;
  }

  /* The narrowest screens fit the role and both marks on the label only at the micro size. */
  @media (width < 30rem) {
    .strip__role,
    .strip__mark,
    .strip__made {
      font-size: var(--fs-micro);
    }
  }

  @media (width >= 48rem) {
    .strip {
      height: 96px;
      padding: 8px;
      padding-inline-end: 16px;
    }

    .strip__box {
      padding: 9px 10px 7px;
    }

    .strip__serial {
      display: flex;
    }

    .strip__text {
      display: block;
    }
  }

  @media (width >= 64rem) {
    .strip__coords {
      display: inline;
    }

    .strip__made :global(.strip__ticks) {
      display: block;
    }
  }
</style>
