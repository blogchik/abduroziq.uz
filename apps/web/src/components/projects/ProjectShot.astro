---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ticketColors } from '@/components/home/lib';
import { sizesFor, stageOf, widthsFor, type Area, type Shape } from './media';
import './frame.css';

/**
 * One project picture in its frame (DESIGN 6.1). A landscape screenshot fills the frame; a
 * phone screenshot, a square panel or an illustration stands at its own size on a matte in
 * the project's background colour (`stageOf` decides from the file). The frame is the shared
 * hairline of `frame.css`.
 *
 * A video takes the same frame: pass its `shape` (the width and height from the yaml) and put
 * the `<video>` in the slot. It follows the rules of a picture of that shape, so a phone
 * recording stands on the matte instead of being stretched to the full width.
 *
 * The space is reserved before the file arrives: a filling picture or video by its own width
 * and height (set them on the `<video>`), a contained one by the stage's aspect ratio. SVGs go
 * through untouched, so an animated illustration keeps playing.
 */
interface Common {
  /** The project's two colours: the first is the matte under a contained picture. */
  colors: [background: string, foreground: string];
  class?: string;
}
interface PictureProps extends Common {
  src: ImageMetadata;
  alt: string;
  /** The width of the frame at each breakpoint, for `sizes`. */
  area: Area;
  /** Above the fold: loaded eagerly and first. Never combine with a reveal. */
  priority?: boolean;
  shape?: never;
}
interface SlotProps extends Common {
  shape: Shape;
  src?: never;
  alt?: never;
  area?: never;
  priority?: never;
}
type Props = PictureProps | SlotProps;

const { src, alt, area, shape, colors, priority = false, class: className } = Astro.props;
const stage = stageOf(src ?? shape);
const vector = src?.format === 'svg';
const matte = ticketColors(colors);
const loading = priority
  ? ({ loading: 'eager', fetchpriority: 'high' } as const)
  : ({ loading: 'lazy' } as const);
---

<div
  class:list={[
    'shot pframe',
    { 'shot--contained': stage, 'shot--edged': stage && !vector },
    className,
  ]}
  style={
    stage && {
      '--shot-matte': matte.bg,
      '--shot-edge': matte.text,
      '--shot-ratio': stage.ratio,
      '--shot-ratio-narrow': stage.ratioNarrow,
      '--shot-fit': `${stage.fit * 100}%`,
      '--shot-fit-narrow': `${stage.fitNarrow * 100}%`,
    }
  }
>
  {!src ? (
    <slot />
  ) : vector ? (
    <Image src={src} alt={alt} {...loading} />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widthsFor(src, Boolean(stage))}
      sizes={sizesFor(area, stage)}
      {...loading}
    />
  )}
</div>

<style>
  .shot :global(:is(img, video)) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot--contained {
    display: grid;
    place-items: center;
    aspect-ratio: var(--shot-ratio-narrow);
    background-color: var(--shot-matte);
  }

  .shot--contained :global(:is(img, video)) {
    width: var(--shot-fit-narrow);
  }

  /* A screenshot on a matte of nearly its own colour would have no edge: it gets a faint
     one in the matte's readable tone. An illustration brings its own outline, or none. */
  .shot--edged :global(img) {
    outline: var(--hairline) solid color-mix(in srgb, var(--shot-edge) 28%, var(--shot-matte));
  }

  @media (width >= 48rem) {
    .shot--contained {
      aspect-ratio: var(--shot-ratio);
    }

    .shot--contained :global(:is(img, video)) {
      width: var(--shot-fit);
    }
  }
</style>
